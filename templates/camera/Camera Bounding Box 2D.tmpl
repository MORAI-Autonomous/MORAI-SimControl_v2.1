{
    "version": "1.0.0-alpha",
    "messageTemplate": {
        "name": "Camera Bounding Box 2D",
        "isControl": false,
        "isSensor": true,
        "description": "Publishes camera image-space 2D boxes. class_id and instance_id carry packed 0x00RRGGBB values; the upper 8 bits are reserved.",
        "segmentList": [
            {
                "type": "FIELDS",
                "relationName": "CameraEntity",
                "fieldList": [
                    { "name": "camera_id", "relationName": "CameraEntity", "variableName": "id", "variableType": "STRING", "length": 64 },
                    { "name": "timestamp_seconds", "relationName": "CameraEntity", "variableName": "time_stamp.seconds", "variableType": "INT64" },
                    { "name": "timestamp_nanos", "relationName": "CameraEntity", "variableName": "time_stamp.nanos", "variableType": "INT32" }
                ]
            },
            {
                "type": "REPEAT",
                "relationName": "CameraEntity",
                "repeatFieldName": "camera_attributes.bound_box_data",
                "fieldList": [
                    { "name": "min_x", "relationName": "CameraEntity", "variableName": "bounding_box_2d.min.x", "variableType": "FLOAT" },
                    { "name": "min_y", "relationName": "CameraEntity", "variableName": "bounding_box_2d.min.y", "variableType": "FLOAT" },
                    { "name": "max_x", "relationName": "CameraEntity", "variableName": "bounding_box_2d.max.x", "variableType": "FLOAT" },
                    { "name": "max_y", "relationName": "CameraEntity", "variableName": "bounding_box_2d.max.y", "variableType": "FLOAT" },
                    { "name": "semantic_color_rgb24_packed", "relationName": "CameraEntity", "variableName": "class_id", "variableType": "UINT32" },
                    { "name": "instance_color_rgb24_packed", "relationName": "CameraEntity", "variableName": "instance_id", "variableType": "UINT32" }
                ]
            }
        ]
    }
}
